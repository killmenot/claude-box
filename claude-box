#!/usr/bin/env bash
# claude-box — host-side entry point. Brings up the claude-box web UI (chat + console) in Docker.
#   claude-box             — build (cached) and start the web UI, print its address
#   claude-box --tunnel    — + publish it on a public https URL (cloudflared without a token / ngrok)
#   claude-box --no-proxy  — run WITHOUT the proxy from .env (the host's direct egress)
#   claude-box --stop      — stop the web UI (running Claude sessions are restored on the next start)
#   claude-box --restart   — rebuild (cached) and recreate the container, even when nothing changed
#   claude-box --status    — is it running, where, which sessions
#   claude-box --login     — print a fresh one-time sign-in link for the web UI (changes nothing else)
#   claude-box --setup     — re-run the first-run setup (the workspace folder, the git identity)
#   claude-box --install   — print how to add claude-box to PATH (changes nothing)
#   claude-box --env NAME  — use .env.NAME instead of .env (or a path to an env file); combines with
#                            the others. Each env file is its own box: own home-NAME/, name and ports
# The first start creates .env and asks where projects live and who commits. The web login and password are set
# in the browser: open the one-time link printed at the end, and the UI asks for them.
set -euo pipefail

# real path of the script (works via symlink and via PATH too) -> repository root
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
REPO="$(cd "$(dirname "$SELF")" && pwd -P)"
CALLER_PWD="$PWD"
PLACEHOLDER='/path/to/your/project'

usage() { sed -n '2,15p' "$SELF" | sed 's/^# \{0,1\}//'; }

# ---------------------------------------------------------------- arguments
action=start; want_tunnel=0; no_proxy=0; force_setup=0
env_arg="${CLAUDE_BOX_ENV:-}"
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  a="${args[i]}"
  case "$a" in
    --env=*)                  env_arg="${a#--env=}" ;;
    --env)                    i=$((i + 1)); env_arg="${args[i]:-}"
                              [ -n "$env_arg" ] || { echo "claude-box: --env needs a name or a file" >&2; exit 2; } ;;
    --tunnel)                 want_tunnel=1 ;;
    --no-proxy)               no_proxy=1 ;;
    --stop|--web-stop)        action=stop ;;
    --restart)                action=restart ;;
    --status|--web-status)    action=status ;;
    --setup)                  force_setup=1 ;;
    --login)                  action=login ;;
    --install)                action=install ;;
    -h|--help)                action=help ;;
    --web|--build)            ;;   # kept for old habits: the web UI is the default and the image is always rebuilt (cached)
    *) echo "claude-box: unknown option: $a" >&2; usage >&2; exit 2 ;;
  esac
done

# The env file: .env by default. --env NAME (or CLAUDE_BOX_ENV) picks .env.NAME next to this script;
# ".env.NAME" works too, and anything with a "/" is a path from the current folder.
# ENV_NAME is the NAME part ("" for .env): it names the box's home folder (home-NAME/).
case "$env_arg" in
  "")      ENV_FILE="$REPO/.env" ;;
  */*)     d="$(cd "$(dirname "$env_arg")" 2>/dev/null && pwd -P)" \
             || { echo "claude-box: no such folder for --env: $env_arg" >&2; exit 2; }
           ENV_FILE="$d/$(basename "$env_arg")" ;;
  .env*)   ENV_FILE="$REPO/$env_arg" ;;
  *)       ENV_FILE="$REPO/.env.$env_arg" ;;
esac
ENV_NAME="$(basename "$ENV_FILE")"
case "$ENV_NAME" in
  .env)         ENV_NAME="" ;;
  .env.example) echo "claude-box: .env.example is the template, copy it to .env.NAME and use --env NAME" >&2; exit 2 ;;
  .env.*)       ENV_NAME="${ENV_NAME#.env.}" ;;
esac
case "$ENV_NAME" in *[!A-Za-z0-9_.-]*)
  echo "claude-box: env name may hold only letters, digits, '.', '_' and '-' (got: $ENV_NAME)" >&2; exit 2 ;;
esac

if [ "$action" = help ]; then usage; exit 0; fi
if [ "$action" = install ]; then
  cat <<EOF
Add claude-box to PATH using one of these methods:

  # symlink (needs sudo once):
  sudo ln -s "$SELF" /usr/local/bin/claude-box

  # or an alias in ~/.bashrc:
  echo 'alias claude-box="$SELF"' >> ~/.bashrc && . ~/.bashrc
EOF
  exit 0
fi

# ---------------------------------------------------------------- .env helpers
# Value of KEY from .env: the last active (uncommented) line wins, surrounding quotes stripped.
env_get() {
  local v
  v="$(grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
  case "$v" in \'*\') v="${v#\'}"; v="${v%\'}" ;; \"*\") v="${v#\"}"; v="${v%\"}" ;; esac
  printf '%s' "$v"
}
# Set KEY=VALUE in .env: replaces the first KEY= line (or a commented-out "# KEY=" from the
# template) in place, drops later duplicates, appends if absent. The value goes through the
# environment, not the awk program, so no character in it is interpreted.
env_set() {
  local tmp
  tmp="$(mktemp "$ENV_FILE.XXXXXX")"
  K="$1" V="$2" awk '
    BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"]; done = 0 }
    {
      if (index($0, k "=") == 1 || $0 ~ ("^#[ \t]*" k "=")) {
        if (!done) { print k "=" v; done = 1 }
        else if (index($0, k "=") != 1) print
        next
      }
      print
    }
    END { if (!done) print k "=" v }' "$ENV_FILE" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$ENV_FILE"
}
interactive() { [ -t 0 ] && [ -t 1 ]; }
ask() {   # ask "Question" "default" -> answer (the default on an empty answer)
  local ans
  if [ -n "$2" ]; then printf '%s [%s]: ' "$1" "$2" >&2; else printf '%s: ' "$1" >&2; fi
  IFS= read -r ans || ans=""
  printf '%s' "${ans:-$2}"
}
expand_home() { case "$1" in "~") printf '%s' "$HOME" ;; "~/"*) printf '%s/%s' "$HOME" "${1#\~/}" ;; *) printf '%s' "$1" ;; esac; }

# ---------------------------------------------------------------- first-run setup
setup_workspace() {
  local cur dir
  cur="$(env_get PROJECT_DIR)"
  if [ "$force_setup" = 0 ] && [ -n "$cur" ] && [ "$cur" != "$PLACEHOLDER" ] && [ -d "$cur" ]; then return 0; fi
  if ! interactive; then
    if [ -z "$cur" ] || [ "$cur" = "$PLACEHOLDER" ]; then echo "✗ PROJECT_DIR is not set in $ENV_FILE" >&2
    else echo "✗ PROJECT_DIR points to a non-existent folder: $cur" >&2; fi
    echo "  Run claude-box in a terminal to set it up, or set PROJECT_DIR in .env by hand." >&2
    exit 1
  fi
  # default: a workspace/ folder next to this script (git-ignored)
  [ -z "$cur" ] || [ "$cur" = "$PLACEHOLDER" ] && cur="$REPO/workspace"
  echo
  echo "Projects: the folder on this computer where your projects live (clones, task folders, files)."
  echo "The box sees it as /workspace. Press Enter for the default."
  while :; do
    dir="$(expand_home "$(ask "  Workspace folder" "$cur")")"
    case "$dir" in /*) ;; *) echo "  Use an absolute path (or ~/...)." >&2; continue ;; esac
    if [ ! -d "$dir" ]; then
      mkdir -p "$dir" 2>/dev/null || { echo "  Could not create $dir." >&2; continue; }
      echo "  Created $dir"
    fi
    # docker would mount a folder the user cannot write as read-only-in-practice /workspace
    [ -w "$dir" ] || { echo "  $dir is not writable by you (uid $(id -u)); pick another folder." >&2; continue; }
    break
  done
  env_set PROJECT_DIR "$(cd "$dir" && pwd -P)"
}

# Several boxes can share one docker daemon (two users of one Mac, two checkouts) only if
# each has its own container name and its own ports: the container uses the host network, so
# the internal ttyd port is shared too. Asked once, when .env is created and another box exists.
taken_names() { docker ps -a --format '{{.Names}}' 2>/dev/null || true; }
setup_instance() {
  local others name n=2 off def
  others="$(taken_names | grep -E -e '-web$' || true)"
  # a named env file (.env.NAME) is a second box by definition: always its own name and ports
  if [ -z "$ENV_NAME" ]; then
    printf '%s\n' "$others" | grep -qx "claude-box-web" || return 0
    echo
    echo "Another claude-box already runs on this Docker (container claude-box-web)."
    echo "This one needs its own name and ports, or starting it would replace that one."
  else
    echo
    echo "$(basename "$ENV_FILE") is its own box: it needs its own name and ports."
  fi
  while printf '%s\n' "$others" | grep -qx "claude-box-$n-web"; do n=$((n + 1)); done
  def="claude-box-$n"
  if [ -n "$ENV_NAME" ]; then
    def="claude-box-$(printf '%s' "$ENV_NAME" | tr 'A-Z.' 'a-z-')"
    printf '%s\n' "$others" | grep -qx "$def-web" && def="claude-box-$n"
  fi
  while :; do
    name="$(ask "  Instance name" "$def")"
    case "$name" in [a-z0-9]*) ;; *) echo "  Start with a lowercase letter or digit." >&2; continue ;; esac
    case "$name" in *[!a-z0-9_-]*) echo "  Lowercase letters, digits, '_' and '-' only." >&2; continue ;; esac
    printf '%s\n' "$others" | grep -qx "$name-web" && { echo "  $name-web is taken." >&2; continue; }
    break
  done
  off=$(( (n - 1) * 10 ))
  env_set CLAUDE_BOX_NAME "$name"
  env_set WEB_TERMINAL_PORT "$(ask "  Web UI port (http)" "$((7681 + off))")"
  env_set WEB_TLS_PORT "$(ask "  Web UI port (https)" "$((8443 + off))")"
  env_set TTYD_PORT "$(ask "  Internal console port" "$((7682 + off))")"
}

# Who the box commits as: asked when the env file is created and on --setup, defaulting to this
# computer's own git identity. Saved as GIT_USER_NAME / GIT_USER_EMAIL; the box writes them to its
# ~/.gitconfig on every start. Left empty, the box takes the GitHub account's identity once gh is
# signed in, and Claude asks rather than borrowing an author from a repository's history.
setup_git_identity() {
  local name email
  name="$(env_get GIT_USER_NAME)"; [ -n "$name" ] || name="$(git config --global user.name 2>/dev/null || true)"
  email="$(env_get GIT_USER_EMAIL)"; [ -n "$email" ] || email="$(git config --global user.email 2>/dev/null || true)"
  echo
  echo "Git: the name and email this box commits as. Enter keeps the default; leave empty to decide later."
  name="$(ask "  Commit name" "$name")"
  while :; do
    email="$(ask "  Commit email" "$email")"
    case "$email" in ""|?*@?*) break ;; esac
    echo "  \"$email\" is not an email address." >&2; email=""
  done
  [ -z "$name" ] || env_set GIT_USER_NAME "$name"
  [ -z "$email" ] || env_set GIT_USER_EMAIL "$email"
}

first_run() {
  local created=0
  if [ ! -f "$ENV_FILE" ]; then
    created=1
    if ! interactive; then echo "✗ $ENV_FILE is missing (copy .env.example and fill it in)." >&2; exit 1; fi
    cp "$REPO/.env.example" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    echo "Created $ENV_FILE from .env.example (tokens, proxy and other settings live there)."
    if [ -z "$(env_get CLAUDE_CODE_OAUTH_TOKEN)" ] && [ -z "$(env_get ANTHROPIC_BASE_URL)" ]; then
      echo "  Claude auth is not configured. Either set CLAUDE_CODE_OAUTH_TOKEN (Anthropic), or"
      echo "  ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN + ANTHROPIC_DEFAULT_*_MODEL (GLM / any"
      echo "  Anthropic-compatible provider) — see README \"Using GLM\"."
    fi
    setup_instance
  fi
  # the container must run as this host user, or it cannot write the home bind mount
  if [ -z "$(env_get BOX_UID)" ]; then env_set BOX_UID "$(id -u)"; env_set BOX_GID "$(id -g)"; fi
  setup_workspace
  if { [ "$created" = 1 ] || [ "$force_setup" = 1 ]; } && interactive; then setup_git_identity; fi
}

# ---------------------------------------------------------------- docker
cd "$REPO"
# The box's home (bind-mounted as /home/node: history, sessions, login): one per env file, so two
# boxes never share it. home/ for .env, home-NAME/ for .env.NAME; BOX_HOME in the env file overrides.
box_home="$(env_get BOX_HOME)"; box_home="${box_home:-./home${ENV_NAME:+-$ENV_NAME}}"
case "$box_home" in /*|./*|../*) ;; *) box_home="./$box_home" ;; esac
mkdir -p "$box_home"
# compose reads these: the container's env_file, the home mount and the label guard_owner checks
export CLAUDE_BOX_ENV_FILE="$ENV_FILE" BOX_HOME="$box_home"

compose_files=(-f docker-compose.yml)
[ "$no_proxy" = 1 ] && compose_files+=(-f docker-compose.no-proxy.yml)
# Network mode: on Linux (incl. WSL2) the container shares the host network directly (Tailscale,
# DBs). Docker Desktop on macOS does NOT map host-mode ports to the real machine, so there we
# swap to bridge + explicit ports (docker-compose.ports.yml). WEB_BIND overrides the auto choice.
bind="$(env_get WEB_BIND)"; bind="${bind:-auto}"
bind_ports=0
case "$bind" in
  ports) bind_ports=1 ;;
  host)  bind_ports=0 ;;
  auto)  case "$(uname -s)" in Darwin*|MINGW*|MSYS*|CYGWIN*) bind_ports=1 ;; esac ;;
  *)     echo "claude-box: WEB_BIND must be auto, host or ports (got: $bind)" >&2; exit 1 ;;
esac
bind_name=$([ "$bind_ports" = 1 ] && echo "ports (bridge+mapping)" || echo "host")
[ "$bind_ports" = 1 ] && compose_files+=(-f docker-compose.ports.yml)
# EXTRA_HOSTS: extra /etc/hosts lines for the container (the box itself cannot edit /etc/hosts).
# Space- or comma-separated; a bare NAME points at the host (host-gateway: the Mac under Docker
# Desktop, the docker bridge address on Linux), NAME=ADDR or NAME:ADDR at a given address.
# Rendered into a throwaway compose overlay; a changed list recreates the container on `up -d`.
hosts_yaml=""; hosts_names=""
set -f   # split the list on blanks only, no glob expansion
for h in $(env_get EXTRA_HOSTS | tr ',' ' '); do
  case "$h" in
    *=*) hn="${h%%=*}"; ha="${h#*=}" ;;
    *:*) hn="${h%%:*}"; ha="${h#*:}" ;;
    *)   hn="$h"; ha="host-gateway" ;;
  esac
  case "$hn" in ""|*[!A-Za-z0-9.-]*) echo "claude-box: EXTRA_HOSTS: bad host name in '$h'" >&2; exit 1 ;; esac
  case "$ha" in ""|*[!A-Za-z0-9.:-]*) echo "claude-box: EXTRA_HOSTS: bad address in '$h'" >&2; exit 1 ;; esac
  hosts_yaml="${hosts_yaml}      ${hn}: \"${ha}\""$'\n'
  hosts_names="${hosts_names:+$hosts_names, }$hn"
done
set +f
if [ -n "$hosts_yaml" ]; then
  hosts_file="$(mktemp "${TMPDIR:-/tmp}/claude-box-hosts.XXXXXX")"
  trap 'rm -f "$hosts_file"' EXIT
  printf 'services:\n  web:\n    extra_hosts:\n%s' "$hosts_yaml" > "$hosts_file"
  compose_files+=(-f "$hosts_file")
fi
# A named instance is its own compose project too (the default project is the folder's name,
# so two checkouts both called claude-box would otherwise be one project).
name_set="$(env_get CLAUDE_BOX_NAME)"; name="$name_set"
# --env-file: compose substitutes ${...} in the compose files from the chosen env file, not ./.env
dc() {
  if [ -n "$name" ]; then COMPOSE_PROJECT_NAME="$name" docker compose "${compose_files[@]}" --env-file "$ENV_FILE" "$@"
  else docker compose "${compose_files[@]}" --env-file "$ENV_FILE" "$@"; fi
}
name="${name:-claude-box}"
container="$name-web"
# Refuse to touch a container of the same name that another checkout started: compose would
# stop and replace it (that is how a second box used to kill the first one).
# The same goes for a container this checkout started from another env file (.env vs .env.NAME
# with the same CLAUDE_BOX_NAME). Containers from before env files were labelled came from .env.
guard_owner() {
  local dir envf owner=""
  dir="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$container" 2>/dev/null || true)"
  [ -n "$dir" ] || return 0
  if [ "$(cd "$dir" 2>/dev/null && pwd -P || echo "$dir")" != "$REPO" ]; then owner="another claude-box ($dir)"
  else
    envf="$(docker inspect -f '{{index .Config.Labels "claude-box.env"}}' "$container" 2>/dev/null || true)"
    case "$envf" in ""|"<no value>") envf="$REPO/.env" ;; esac
    [ "$envf" = "$ENV_FILE" ] && return 0
    owner="the box of $envf"
  fi
  echo "✗ Container $container belongs to $owner." >&2
  echo "  Give this one its own CLAUDE_BOX_NAME and ports in $ENV_FILE" >&2
  echo "  (WEB_TERMINAL_PORT, WEB_TLS_PORT, TTYD_PORT), then run claude-box again." >&2
  exit 1
}

port="$(env_get WEB_TERMINAL_PORT)"; port="${port:-7681}"
tls_port="$(env_get WEB_TLS_PORT)"; tls_port="${tls_port:-8443}"
# the address to open: what the UI actually listens on (WEB_TERMINAL_INTERFACE), not just localhost.
# https is the default (secure context: clipboard and notifications); plain http only when TLS is off.
iface="$(env_get WEB_TERMINAL_INTERFACE)"; iface="${iface:-127.0.0.1}"
host="$iface"
[ "$iface" = 127.0.0.1 ] && host="localhost"
[ "$iface" = 0.0.0.0 ] && host="$(hostname -I 2>/dev/null | awk '{print $1}')" && host="${host:-localhost}"
# Both addresses are printed when TLS is on: https (self-signed, the browser warns until the
# cert is trusted) and plain http, which needs no cert (on localhost it is a secure context too).
http_url="http://${host}:${port}"
if [ "$(env_get WEB_TLS)" = 0 ]; then url="$http_url"; url_note=""; alt_url=""
else url="https://${host}:${tls_port}"; url_note="   (self-signed cert; enables clipboard and notifications)"
  alt_url="$http_url"; fi
alt_note="   (plain http, no certificate warning)"
# A one-time sign-in key: it goes to <home>/.claude (the box's own home, private), the browser
# that opens a link with it within 15 minutes is signed in and the key is used up. One key serves
# both addresses, so either link works, but only once.
signin_links() {
  local key
  mkdir -p "$box_home"/.claude
  key="$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c1-32)"
  ( umask 077; printf '%s\n' "$key" > "$box_home"/.claude/web-login-key )
  echo "  ${url}/?key=${key}"
  [ -z "$alt_url" ] || echo "  ${alt_url}/?key=${key}"
}
# a login exists: set in the UI (web-auth.json) or the old WEB_TERMINAL_PASSWORD in .env
has_login() { [ -n "$(env_get WEB_TERMINAL_PASSWORD)" ] || grep -q '"hash"' "$box_home"/.claude/web-auth.json 2>/dev/null; }

case "$action" in
  login)
    echo "Sign in to claude-box (one-time link, valid 15 minutes; either address):"
    signin_links
    exit 0
    ;;
  stop)
    guard_owner
    dc rm -sf web
    echo "claude-box stopped."
    exit 0
    ;;
  status)
    cid="$(docker ps -q --filter "name=^${container}\$" | head -n1)"
    if [ -z "$cid" ]; then echo "claude-box is not running."; exit 0; fi
    echo "claude-box is running: ${url}"
    url="$(head -n1 "$box_home"/.claude/web-tunnel-url 2>/dev/null || true)"
    [ -n "$url" ] && echo "Public tunnel: ${url}"
    echo "Console sessions (tmux):"
    docker exec "$cid" tmux list-sessions 2>/dev/null || echo "  (none)"
    exit 0
    ;;
esac

# --- start ---
first_run
# the setup may have just named this instance
if [ -z "$name_set" ] && [ -n "$(env_get CLAUDE_BOX_NAME)" ]; then
  rm -f "${hosts_file:-}"   # exec skips the EXIT trap; the new run renders its own
  cd "$CALLER_PWD" && exec "$SELF" "$@"
fi
guard_owner

# Build bypassing the proxy: compose reads .env at build time too and would pick up HTTPS_PROXY
# (it is meant only for Claude -> Anthropic at run time). Through the proxy BuildKit fails to
# resolve FROM (Docker Hub anon token -> 401) and GitHub release downloads time out.
build_args=(
  --build-arg HTTP_PROXY= --build-arg HTTPS_PROXY=
  --build-arg http_proxy= --build-arg https_proxy=
  --build-arg NO_PROXY='*' --build-arg no_proxy='*'
)
# The build runs on the host network (build.network: host in docker-compose.yml). Newer compose
# always builds through `buildx bake`, which refuses that without --allow=network.host, and
# `compose build` has no way to pass it. So compose only renders the bake definition and bake
# builds it with the entitlement granted. Older compose/buildx without --print: plain build.
if bake_def="$(dc build --print "${build_args[@]}" web 2>/dev/null)" && [ -n "$bake_def" ]; then
  printf '%s\n' "$bake_def" | docker buildx bake --allow=network.host -f - web
else
  dc build "${build_args[@]}" web
fi

tunnel=0
if [ "$want_tunnel" = 1 ]; then
  # fail closed: a public shell without a password is not allowed (the container checks it too)
  if ! has_login; then
    echo "✗ Tunnel not started: there is no login yet. Open the link below, set a login and password,"
    echo "  then run claude-box --tunnel again. Bringing up the web UI locally, without public access."
  else
    tunnel=1
  fi
fi
# --restart: recreate the container even when its config and image are unchanged (plain `up -d`
# would leave it running). It is stopped only now, after the build, so the old one serves meanwhile.
recreate=()
[ "$action" = restart ] && recreate=(--force-recreate)
WEB_TUNNEL="$([ "$tunnel" = 1 ] && echo 1 || true)" dc up -d ${recreate[@]+"${recreate[@]}"} web

echo
echo "claude-box is up:"
echo "  ${url}${url_note}"
[ -z "$alt_url" ] || echo "  ${alt_url}${alt_note}"
echo "  network: ${bind_name}"
[ -z "$hosts_names" ] || echo "  extra hosts: ${hosts_names}"
echo
if has_login; then echo "Sign in with your login and password, or on this computer with a one-time link (15 min, either address):"
else echo "Open a one-time link to sign in (15 min, either address); the page then asks you to pick a login and password:"; fi
signin_links

if [ "$tunnel" = 1 ]; then
  if [ -n "$(env_get NGROK_AUTHTOKEN)" ]; then echo "Bringing up a public tunnel (ngrok)…"
  else echo "Bringing up a public tunnel (cloudflared, no token)…"; fi
  # The container writes the URL to <home>/.claude/web-tunnel-url (bind mount). cloudflared buffers
  # its log and flushes the URL late, so its log is grepped directly as well. Wait window ~60s.
  url=""
  for _ in $(seq 1 120); do
    [ -s "$box_home"/.claude/web-tunnel-url ] && { url="$(head -n1 "$box_home"/.claude/web-tunnel-url)"; break; }
    u="$(grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$box_home"/.claude/cloudflared.log 2>/dev/null | head -n1 || true)"
    [ -n "$u" ] && { url="$u"; break; }
    sleep 0.5
  done
  if [ -n "$url" ]; then echo "🌍 Public access: ${url}  (sign in with your login and password)"
  else echo "⚠ Tunnel not visible yet. Check: docker compose logs web"; fi
fi
