{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(/workspace/claude-box/.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(**/.env.*)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat *.env*)",
      "Bash(cat /workspace/claude-box/.env)",
      "Bash(less .env)",
      "Bash(head*.env*)",
      "Bash(tail*.env*)",
      "Bash(grep* .env*)",
      "Bash(source .env)",
      "Bash(. .env)",
      "Read(./.env.*)",
      "Bash(cat* .env*)",
      "Bash(more* .env*)",
      "Bash(bat* .env*)",
      "Bash(sed* .env*)",
      "Bash(awk* .env*)",
      "Bash(cut* .env*)",
      "Bash(sort* .env*)",
      "Bash(xxd* .env*)",
      "Bash(od* .env*)",
      "Bash(strings* .env*)",
      "Bash(base64* .env*)",
      "Bash(cp* .env*)",
      "Bash(rg* .env*)",
      "Bash(diff* .env*)",
      "Read(*.tfvars)",
      "Read(**/*.tfvars)",
      "Read(*.tfvars.json)",
      "Read(**/*.tfvars.json)",
      "Bash(cat* *.tfvars*)",
      "Bash(less* *.tfvars*)",
      "Bash(more* *.tfvars*)",
      "Bash(head* *.tfvars*)",
      "Bash(tail* *.tfvars*)",
      "Bash(grep* *.tfvars*)",
      "Bash(bat* *.tfvars*)",
      "Bash(sed* *.tfvars*)",
      "Bash(awk* *.tfvars*)",
      "Bash(cut* *.tfvars*)",
      "Bash(sort* *.tfvars*)",
      "Bash(xxd* *.tfvars*)",
      "Bash(od* *.tfvars*)",
      "Bash(strings* *.tfvars*)",
      "Bash(base64* *.tfvars*)",
      "Bash(cp* *.tfvars*)",
      "Bash(rg* *.tfvars*)",
      "Bash(diff* *.tfvars*)",
      "Bash(source* *.tfvars*)"
    ]
  }
}
