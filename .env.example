# claude-box settings. `./claude-box` creates .env from this file on the first start and asks
# for the workspace folder and the web login/password itself; everything else is optional.
# Never commit .env — it holds tokens.

# --- Claude box container name ----------------------------------------------------------------
CLAUDE_BOX_NAME=claude-box

# --- Workspace ---------------------------------------------------------------------------------
# Host folder with your projects, mounted as /workspace (asked on the first start, default ~/workspace).
PROJECT_DIR=/path/to/your/project
# Host's own ~/.claude, mounted read-only at /host-claude (default: $HOME/.claude).
# HOST_CLAUDE_DIR=/home/you/.claude/projects

# --- Claude ------------------------------------------------------------------------------------
# Long-lived token from `claude setup-token` (also skips Claude Code's first-run login).
CLAUDE_CODE_OAUTH_TOKEN=

# --- Proxy (optional) --------------------------------------------------------------------------
# Claude -> Anthropic traffic through a TLS proxy; put the proxy's certificate in certs/*.crt.
# The image build always goes direct; `claude-box --no-proxy` runs without the proxy once.
# HTTPS_PROXY=https://user:password@proxy.example.com:8443
# Hosts that must NOT go through the proxy (Tailscale, databases, local services).
# NO_PROXY=localhost,127.0.0.1,.ts.net

# --- Web UI ------------------------------------------------------------------------------------
# Login and password the browser asks for (set on the first start; `claude-box --setup` changes them).
# The password is required for --tunnel. Avoid spaces, quotes, $, # and \ in it.
# WEB_TERMINAL_USER=claude
# WEB_TERMINAL_PASSWORD=
# http port of the UI, and the https one (self-signed: clipboard + browser notifications).
WEB_TERMINAL_PORT=7681
WEB_TLS_PORT=8443
# Listen address. 127.0.0.1 = this machine only; 0.0.0.0 = the LAN too (ONLY with a password).
WEB_TERMINAL_INTERFACE=127.0.0.1
# Extra names/IPs for the self-signed certificate, e.g. DNS:box.lan,IP:192.168.1.10
# WEB_TLS_SAN=
# Plain http only, no certificate:
# WEB_TLS=0
# Console font size:
# WEB_TERMINAL_FONT_SIZE=14

# --- Sessions ----------------------------------------------------------------------------------
# Bring running sessions back after a container restart (1 = on).
WEB_RESTORE_SESSIONS=1
# Stop a web chat's Claude process after this many idle minutes (it resumes on the next message).
WEB_CHAT_IDLE_MINUTES=60
# Where files attached in the chat are saved (default ~/.claude/web-uploads).
# WEB_CHAT_UPLOADS=
# Max results of the history search in the sidebar.
# CLAUDE_WEB_SEARCH_LIMIT=100
# Bell + tab-title signals when Claude finishes / waits (any value turns them off).
# CLAUDE_NOTIFY_DISABLE=1

# --- Footer bar (metrics) ----------------------------------------------------------------------
# Disk shown in the footer, and the context window size for the "context used" meter.
# METRICS_DISK_PATH=/workspace
# CLAUDE_CONTEXT_MAX=200000

# --- Public access: claude-box --tunnel --------------------------------------------------------
# Without a token the tunnel is cloudflared (TryCloudflare, random *.trycloudflare.com address).
# With NGROK_AUTHTOKEN it goes through ngrok; NGROK_DOMAIN gives a permanent address.
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=

# --- Tools inside the box (optional) -----------------------------------------------------------
# GitHub CLI (gh) and the github MCP server — see README "How to get a GH_TOKEN".
# GH_TOKEN=
# context7 MCP server (library docs).
# CONTEXT7_API_KEY=
# grafana MCP server.
# GRAFANA_URL=https://grafana.example.com
# GRAFANA_SERVICE_ACCOUNT_TOKEN=

# --- Model provider: GLM (z.ai) or any Anthropic-compatible provider ---------------------------
# Uncomment and fill in for GLM. Works in the web chat and the console alike.
# CLAUDE_CODE_OAUTH_TOKEN above must stay EMPTY in this mode.
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_DEFAULT_SONNET_MODEL=GLM-5.3-Flash
# ANTHROPIC_DEFAULT_OPUS_MODEL=GLM-5.3-Flash
# ANTHROPIC_DEFAULT_HAIKU_MODEL=GLM-5.3-Flash

# --- Outline (wiki) over MCP: Claude searches, reads and edits your Outline docs ---------------
# OUTLINE_URL: your workspace (https://<subdomain>.getoutline.com, or your own install's domain);
# the box connects to OUTLINE_URL/mcp. OUTLINE_API_KEY: Outline -> Settings -> API Keys.
# MCP must be on for the workspace (Settings -> Workspace -> AI). Left empty, the "outline"
# MCP server stays unauthenticated, like "github" without GH_TOKEN.
# OUTLINE_URL=https://<subdomain>.getoutline.com
# OUTLINE_API_KEY=

# --- git: who the box commits as ---
# Asked by ./claude-box when this file is created (and on --setup); written to the box's
# ~/.gitconfig on every start. Empty: the box keeps its ~/.gitconfig, or takes the GitHub
# account's identity once gh is signed in; Claude asks rather than guessing.
# GIT_USER_NAME=
# GIT_USER_EMAIL=

# ---------------------------------------------------------------- local domains
# Extra /etc/hosts lines for the container (the box runs without root and cannot edit
# /etc/hosts itself). Space- or comma-separated.
#   NAME           -> the host machine (Docker's host-gateway: the Mac under Docker Desktop,
#                     the docker bridge address on Linux)
#   NAME=ADDR      -> a fixed address (NAME:ADDR works too), e.g. NAME=127.0.0.1 under host
#                     networking when the service listens on loopback only
# A changed list recreates the container on the next ./claude-box run.
# EXTRA_HOSTS=

# --- Jira REST (optional) ---
# The Atlassian MCP connector cannot upload attachments. With these set, agents in the box can
# call the Jira REST API directly (basic auth: email + API token), e.g. to attach files to issues.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_USER_EMAIL=you@example.com
# JIRA_API_TOKEN=

# --- Team plugins (optional) -------------------------------------------------------------------
# Plugin marketplaces the box adds and pulls on every start (and every WEB_PLUGINS_SYNC_MIN minutes,
# default 60, 0 = only at start): GitHub owner/repo, a git URL, or a path inside the box; space- or
# comma-separated. PLUGINS: plugin@marketplace ids to install and keep updated. Empty: nothing runs.
PLUGIN_MARKETPLACES=SwiftDriveCorp/claude-swf-skills
PLUGINS=swiftdrive@swiftdrive-skills
